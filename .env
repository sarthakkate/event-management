# Database Configuration
# ⚠️  Local MongoDB is not running. Use MongoDB Atlas (free):
# 1. Go to https://www.mongodb.com/cloud/atlas and create a free account
# 2. Create a free cluster, then click "Connect" → "Drivers" to get your URI
# 3. Replace the URI below with your Atlas connection string:
MONGODB_URI=mongodb+srv://patilav1610:12345@cluster0.ttbvx.mongodb.net/event-management?retryWrites=true&w=majority&appName=Cluster0
# Example: MONGODB_URI=mongodb+srv://myuser:mypass@cluster0.abcde.mongodb.net/event-management?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
# For Gmail: Create an App Password at https://myaccount.google.com/apppasswords

# Or use other email service like SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# Client Configuration
CLIENT_URL=http://localhost:5000
ADMIN_EMAIL=admin@example.com
